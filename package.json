{
  "name": "wicksense-signal-pro",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @wicksense/web",
    "build": "npm install --install-strategy=nested -w @wicksense/web && npm run build -w @wicksense/web",
    "start:prod": "npm run start:prod -w @wicksense/web",
    "lint": "npm run lint -w @wicksense/web"
  }
}
