# WickSense Signal Pro — production environment (Render)
# Set these in Render Dashboard → Service → Environment

# --- Required ---
NODE_ENV=production
DATABASE_URL=file:/var/data/data/wicksense.db
WICKSENSE_DATA_DIR=/var/data/data
TRADE_ENGINE_ENABLED=true

# Alpaca (paper recommended until live is validated)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Protect optional external cron hitting /api/cron/trade-engine (auto-generated on Render blueprint)
CRON_SECRET=

# --- Optional alerts ---
# Set to false to disable all outbound email alerts
ALERTS_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Render sets automatically:
# PORT
# RENDER_EXTERNAL_URL
# RENDER_GIT_COMMIT
