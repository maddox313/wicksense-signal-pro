{
  "name": "@wicksense/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx prisma db push && node --max-old-space-size=4096 ./node_modules/next/dist/bin/next dev",
    "build": "npx prisma generate && npm rebuild lightningcss @tailwindcss/oxide && next build",
    "start": "next start",
    "start:prod": "npx prisma db push && node scripts/start-prod.mjs",
    "worker:trade-engine": "node scripts/trade-engine-worker.mjs",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "test:sync": "node --experimental-strip-types --test src/lib/position-sync-helpers.test.ts src/lib/alpaca-order-fill.test.ts"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.8.0",
    "@prisma/client": "7.8.0",
    "@prisma/config": "7.8.0",
    "@tailwindcss/oxide": "4.3.2",
    "@tailwindcss/postcss": "4.3.2",
    "@wicksense/core": "*",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.7",
    "lightningcss": "1.32.0",
    "lightweight-charts": "^5.0.3",
    "lucide-react": "^0.475.0",
    "next": "^15.2.0",
    "nodemailer": "^9.0.1",
    "postcss": "^8.5.15",
    "prisma": "7.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "4.3.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.2.0",
    "typescript": "^5.8.2"
  },
  "optionalDependencies": {
    "@next/swc-linux-x64-gnu": "15.5.19",
    "@next/swc-win32-x64-msvc": "15.5.19",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.2",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.2",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-win32-x64-msvc": "1.32.0"
  }
}
